{
  "manifest_version": 3,
  "name": "BYR Docs Wiki Print",
  "version": "0.1.3",
  "description": "为 BYR Docs 维基真题试卷页提供打印选项（概要信息、答案等）。",
  "homepage_url": "https://github.com/haohaomin/byrdocs-wiki-print",
  "permissions": [
    "storage",
    "alarms"
  ],
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wiki.byrdocs.org/exam/*",
        "https://*.wiki.byrdocs.org/exam/*",
        "http://localhost:4321/exam/*",
        "http://127.0.0.1:4321/exam/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "ui.css",
        "print.css"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
